#!/usr/bin/env bash

# Check if the minimum required arguments are provided
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "Usage: $0 <path_to_binary> <symbol_name_or_fragment_or_-> [index]"
    echo "Example: $0 /lib/x86_64-linux-gnu/libc.so.6 memcpy"
    echo "Example with index: $0 /lib/x86_64-linux-gnu/libc.so.6 memcpy 2"
    echo "Example to list all symbols: $0 /lib/x86_64-linux-gnu/libc.so.6 -"
    echo "Example to list all and pick index: $0 /lib/x86_64-linux-gnu/libc.so.6 - 42"
    exit 1
fi

BINARY="$1"
SEARCH_TERM="$2"
INDEX="$3" # Optional third parameter (number)

# Check if the file exists
if [ ! -f "$BINARY" ]; then
    echo "Error: File '$BINARY' does not exist."
    exit 1
fi

# 1. Fetch raw symbols and immediately filter out everything except FUNC type
RAW_ALL=$( (readelf -sW "$BINARY" 2>/dev/null; readelf -DW "$BINARY" 2>/dev/null) | awk '
    /Num:/ { next }
    /Symbol table/ { next }
    /^[[:space:]]*$/ { next }
    {
        # In standard readelf -W output:
        # Type is usually in the 4th column ($4). We check if it is "FUNC".
        # We also safeguard against ABS/UND just in case and ensure a valid name exists.
        is_func = 0
        is_bad = 0
        
        # Scan columns to find "FUNC" type and avoid ABS/UND
        for (i=1; i<=NF; i++) {
            if ($i == "FUNC") is_func = 1
            if ($i == "ABS" || $i == "UND") is_bad = 1
        }
        
        if (is_func && !is_bad && $NF != "Name" && $NF !~ /^[0-9]+$/ && $NF !~ /^\([0-9]+\)$/) {
            print $0
        }
    }
' | sort -u )

# 2. Filter by search term if user did not pass '-'
if [ "$SEARCH_TERM" = "-" ]; then
    RAW_LINES="$RAW_ALL"
else
    RAW_LINES=$(echo "$RAW_ALL" | grep -E "[[:space:]]${SEARCH_TERM}" )
fi

if [ -z "$RAW_LINES" ]; then
    echo "No executable functions found matching: $SEARCH_TERM"
    exit 0
fi

# 3. Extract unique, clean function names from our filtered dataset
UNIQUE_NAMES=$(echo "$RAW_LINES" | awk '{print $NF}' | grep -E '^[a-zA-Z_][a-zA-Z0-9_@.]*$' | sort -u)

if [ -z "$UNIQUE_NAMES" ]; then
    if [ "$SEARCH_TERM" = "-" ]; then
        echo "No valid functions found in the binary."
    else
        echo "No valid functions found matching: $SEARCH_TERM"
    fi
    exit 0
fi

TOTAL_FOUND=$(echo "$UNIQUE_NAMES" | wc -l)
COUNT=$TOTAL_FOUND

# If multiple symbols are found and the user provided an index, select that specific one
if [ "$COUNT" -gt 1 ] && [ -n "$INDEX" ]; then
    if [[ "$INDEX" =~ ^[0-9]+$ ]] && [ "$INDEX" -le "$COUNT" ] && [ "$INDEX" -gt 0 ]; then
        SELECTED_NAME=$(echo "$UNIQUE_NAMES" | sed -n "${INDEX}p")
        RAW_LINES=$(echo "$RAW_LINES" | grep -E "[[:space:]]${SELECTED_NAME}$")
        UNIQUE_NAMES="$SELECTED_NAME"
        COUNT=1
    else
        echo "Error: Invalid index '$INDEX'. Must be a number between 1 and $COUNT."
        exit 1
    fi
fi

if [ "$COUNT" -eq 1 ]; then
    FULL_SYMBOL=$(echo "$UNIQUE_NAMES" | xargs)
    MATCH_LINE=$(echo "$RAW_LINES" | head -n 1)
    
    ADDR=$(echo "$MATCH_LINE" | awk '{print $2}')
    SIZE=$(echo "$MATCH_LINE" | awk '{print $3}')
    
    if [[ "$ADDR" =~ ^[0-9a-fA-F]+$ ]] && [ "$SIZE" -gt 0 ]; then
        START_ADDR="0x$ADDR"
        END_ADDR=$(printf "0x%016x" $(( 0x$ADDR + SIZE )))
        
        if [ "$TOTAL_FOUND" -gt 1 ]; then
            echo "Found $TOTAL_FOUND functions. Selected index $INDEX: $FULL_SYMBOL"
        else
            echo "Found exactly 1 function: $FULL_SYMBOL"
        fi
        echo "Address: $START_ADDR to $END_ADDR (Size: $SIZE bytes)."
        
        # Disassemble using precise address limits
        objdump -M intel -d --start-address="$START_ADDR" --stop-address="$END_ADDR" "$BINARY" | \
            sed -E '1,/Disassembly of section/d; /^[[:space:]]*$/d'  | \
            grep -v "Disassembly of section" | grep -v "file format"
    else
        CLEAN_SYMBOL="${FULL_SYMBOL%%@*}"
        if [ "$TOTAL_FOUND" -gt 1 ]; then
            echo "Found $TOTAL_FOUND functions. Selected index $INDEX: $FULL_SYMBOL (Using name fallback)."
        else
            echo "Found exactly 1 function: $FULL_SYMBOL (Using name fallback)."
        fi
        
        objdump -M intel -d --disassemble="$CLEAN_SYMBOL" "$BINARY" | \
            sed -E '1,/Disassembly of section/d; /^[[:space:]]*$/d' | \
            grep -v "Disassembly of section" | grep -v "file format"

    fi
    
else
    if [ "$SEARCH_TERM" = "-" ]; then
        echo "All valid functions found ($COUNT). Please select the index number as the 3rd argument:"
    else
        echo "Multiple functions found ($COUNT). Please narrow down your search or provide the index number as the 3rd argument:"
    fi
    echo "$UNIQUE_NAMES" | awk '{print "  " NR ") " $0}'
fi

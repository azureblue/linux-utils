#!/usr/bin/env bash

# Check if the minimum required arguments are provided
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "Usage: $0 <path_to_binary> <symbol_name_or_fragment> [index]"
    echo "Example: $0 /lib/x86_64-linux-gnu/libc.so.6 memcpy"
    echo "Example with index: $0 /lib/x86_64-linux-gnu/libc.so.6 memcpy 2"
    exit 1
fi

BINARY="$1"
SEARCH_TERM="$2"
INDEX="$3" # Optional third parameter

# Check if the file exists
if [ ! -f "$BINARY" ]; then
    echo "Error: File '$BINARY' does not exist."
    exit 1
fi

# 1. Fetch matching symbols from both static (-s) and dynamic (-D) tables
RAW_LINES=$( (readelf -s "$BINARY" 2>/dev/null; readelf -D "$BINARY" 2>/dev/null) | grep -E "[[:space:]]${SEARCH_TERM}" | sort -u )

if [ -z "$RAW_LINES" ]; then
    echo "No symbols found matching: $SEARCH_TERM"
    exit 0
fi

# Extract unique symbol names (last column)
UNIQUE_NAMES=$(echo "$RAW_LINES" | awk '{print $NF}' | sort -u)
TOTAL_FOUND=$(echo "$UNIQUE_NAMES" | wc -l)
COUNT=$TOTAL_FOUND

# If multiple symbols are found and the user provided an index, select that specific one
if [ "$COUNT" -gt 1 ] && [ -n "$INDEX" ]; then
    # Validate if INDEX is a proper number and within range
    if [[ "$INDEX" =~ ^[0-9]+$ ]] && [ "$INDEX" -le "$COUNT" ] && [ "$INDEX" -gt 0 ]; then
        # Pick the N-th symbol from the list
        SELECTED_NAME=$(echo "$UNIQUE_NAMES" | sed -n "${INDEX}p")
        # Filter RAW_LINES to match only this specific symbol line
        RAW_LINES=$(echo "$RAW_LINES" | grep -E "[[:space:]]${SELECTED_NAME}$")
        UNIQUE_NAMES="$SELECTED_NAME"
        COUNT=1
    else
        echo "Error: Invalid index '$INDEX'. Must be a number between 1 and $COUNT."
        exit 1
    fi
fi

if [ "$COUNT" -eq 1 ]; then
    # Clean up whitespace and full symbol string
    FULL_SYMBOL=$(echo "$UNIQUE_NAMES" | xargs)
    MATCH_LINE=$(echo "$RAW_LINES" | head -n 1)
    
    ADDR=$(echo "$MATCH_LINE" | awk '{print $2}')
    SIZE=$(echo "$MATCH_LINE" | awk '{print $3}')
    
    if [[ "$ADDR" =~ ^[0-9a-fA-F]+$ ]] && [ "$SIZE" -gt 0 ]; then
        START_ADDR="0x$ADDR"
        # Calculate end address using basic shell hex arithmetic
        END_ADDR=$(printf "0x%x" $(( 0x$ADDR + SIZE )))
        
        if [ "$TOTAL_FOUND" -gt 1 ]; then
            echo "Found $TOTAL_FOUND symbols. Selected index $INDEX: $FULL_SYMBOL"
        else
            echo "Found exactly 1 symbol: $FULL_SYMBOL"
        fi
        echo "Address: $START_ADDR to $END_ADDR (Size: $SIZE bytes)."
        
        # Disassemble based on calculated precise address boundaries and strip headers/leading empty lines
        objdump -M intel -d --start-address="$START_ADDR" --stop-address="$END_ADDR" "$BINARY" | \
            sed -E '1,/Disassembly of section/d; /^[[:space:]]*$/d'
    else
        # Fallback to name if size parsing failed (unlikely)
        CLEAN_SYMBOL="${FULL_SYMBOL%%@*}"
        if [ "$TOTAL_FOUND" -gt 1 ]; then
            echo "Found $TOTAL_FOUND symbols. Selected index $INDEX: $FULL_SYMBOL (Using name fallback)."
        else
            echo "Found exactly 1 symbol: $FULL_SYMBOL (Using name fallback)."
        fi
        objdump -M intel -d --disassemble="$CLEAN_SYMBOL" "$BINARY" | \
            sed -E '1,/Disassembly of section/d; /^[[:space:]]*$/d'
    fi
    
else
    # If multiple symbols found and no valid index was chosen, list them with line numbers
    echo "Multiple symbols found ($COUNT). Please narrow down your search or provide the index number as the 3rd argument:"
    echo "--------------------------------------------------------"
    echo "$UNIQUE_NAMES" | awk '{print "  " NR ") " $0}'
    echo "--------------------------------------------------------"
fi
